# Optional: a private Unichain Sepolia RPC URL (your own node / provider).
# Without this the app falls back to the public endpoint (https://sepolia.unichain.org),
# which is rate-limited and caps getLogs at a small block range.
NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org

# Ponder indexer (see ../indexer). Defaults to http://localhost:42069 in dev.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
